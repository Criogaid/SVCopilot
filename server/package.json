    "smoke:mcp": "node ../test/mcp-client-smoke.mjs",
    "doctor": "node ../tools/doctor-cli.mjs",
    "download:sv-api": "node ../tools/download-sv-api-docs.mjs",
    "parse:sv-api": "node ../tools/parse-sv-api-docs.mjs",
